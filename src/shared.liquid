<!--
  TRMNL Shared Partial & Styles (Braun / Bang & Olufsen Aesthetic)
  Automatically prepended to full, half_horizontal, half_vertical, and quadrant views.
-->

{% if data.error %}
  {% assign var_error = data.error %}
{% else %}
  {% assign var_error = error %}
{% endif %}

{% if data.game_name %}
  {% assign var_game_name = data.game_name %}
  {% assign var_category_name = data.category_name %}
  {% assign var_cover_image = data.cover_image %}
  {% assign var_logo_image = data.logo_image %}
  {% assign var_icon_image = data.icon_image %}
  {% assign var_trophy_image = data.trophy_image %}
  {% assign var_wr_holder = data.wr_holder %}
  {% assign var_wr_date = data.wr_date %}
  {% assign var_wr_time = data.wr_time %}
  {% assign var_released_year = data.released_year %}
  {% assign var_system = data.system %}
  {% assign var_total_runs = data.total_runs %}
  {% assign var_top_runs = data.top_runs %}
  {% assign var_rules_summary = data.rules_summary %}
{% else %}
  {% assign var_game_name = game_name %}
  {% assign var_category_name = category_name %}
  {% assign var_cover_image = cover_image %}
  {% assign var_logo_image = logo_image %}
  {% assign var_icon_image = icon_image %}
  {% assign var_trophy_image = trophy_image %}
  {% assign var_wr_holder = wr_holder %}
  {% assign var_wr_date = wr_date %}
  {% assign var_wr_time = wr_time %}
  {% assign var_released_year = released_year %}
  {% assign var_system = system %}
  {% assign var_total_runs = total_runs %}
  {% assign var_top_runs = top_runs %}
  {% assign var_rules_summary = rules_summary %}
{% endif %}

<style>
  /* Speaker Grille Sidebar / Header Strip */
  .game-sidebar {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0;
  }

  .speaker-grille {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(var(--gray-30, #000000) 1.5px, transparent 1.8px);
    background-size: 8px 8px;
    z-index: 1;
  }

  .photo-frame {
    aspect-ratio: 95 / 134;
    width: auto;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 2;
    box-shadow: 5px 5px 0px var(--framework-border-strong, #000000);
  }

  .photo-frame--fixed {
    flex-shrink: 0;
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px;
    text-align: center;
    background-color: var(--gray-60, #e5e5e5);
    color: var(--framework-border-strong, #000000);
  }

  .cover-fallback--hidden {
    display: none;
  }

  .cover-fallback-tag {
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .error-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .error-card {
    width: 100%;
    max-width: 620px;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    box-shadow: 6px 6px 0px var(--framework-border-strong, #000000);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .error-message {
    color: var(--framework-border-strong, #000000);
  }

  .main-stats {
    flex: 1;
    justify-content: flex-start;
  }

  .half-split-row {
    flex: 1;
    align-items: stretch;
  }

  .half-split-col {
    flex: 1;
    min-width: 0;
  }

  .half-runs-col {
    justify-content: center;
  }

  .hv-hero-inner {
    align-items: center;
    min-width: 0;
  }

  .header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 3px solid var(--framework-border-strong, #000000);
    padding-bottom: 6px;
  }

  .header-title {
    font-weight: 800;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .braun-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--framework-border-strong, #000000);
    display: inline-block;
    flex-shrink: 0;
  }

  .header-category {
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .hero-wr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    box-shadow: 5px 5px 0px var(--framework-border-strong, #000000);
  }

  .hero-wr--stacked {
    align-items: flex-start;
    justify-content: space-between;
  }

  .wr-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .braun-kicker {
    letter-spacing: 1.5px;
    font-weight: 800;
  }

  .wr-date {
    color: var(--gray-10, #1a1a1a);
    text-transform: uppercase;
  }

  /* Braun Parameter Spec Box */
  .spec-box {
    display: flex;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    text-align: center;
    box-shadow: 5px 5px 0px var(--framework-border-strong, #000000);
  }

  .spec-item {
    flex: 1;
    padding: 5px 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .spec-item:not(:last-child) {
    border-right: 3px solid var(--framework-border-strong, #000000);
  }

  .spec-label {
    font-weight: 800;
    color: var(--gray-10, #1a1a1a);
    text-transform: uppercase;
  }

  .spec-val {
    font-weight: bold;
    text-transform: uppercase;
  }

  .braun-item {
    display: flex;
    align-items: center;
    border: 3px solid var(--framework-border-strong, #000000);
    min-height: 32px;
    background: var(--white, #ffffff);
    box-shadow: 4px 4px 0px var(--framework-border-strong, #000000);
  }

  .braun-index {
    width: 40px;
    align-self: stretch;
    border-right: 3px solid var(--framework-border-strong, #000000);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    background-color: var(--gray-50, #d4d4d4);
    flex-shrink: 0;
  }

  .braun-item-body {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 4px 12px;
    min-width: 0;
  }

  .runner-name {
    font-weight: bold;
    text-transform: uppercase;
  }

  .run-date {
    color: var(--gray-10, #1a1a1a);
    margin-left: 8px;
  }

  .rules-container {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 3px double var(--framework-border-strong, #000000);
    padding-top: 8px;
  }

  .rules-body {
    color: var(--gray-10, #1a1a1a);
    font-style: italic;
    padding: 0 4px;
  }

  /* Abstract Braun dot grille filling remaining space dynamically */
  .abstract-dots {
    flex-grow: 1;
    width: 100%;
    background-image: radial-gradient(var(--gray-30, #000000) 1.5px, transparent 1.8px);
    background-size: 8px 8px;
    min-height: 8px;
  }

  .abstract-dots--spaced {
    margin-top: 10px;
  }
</style>
