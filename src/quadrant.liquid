<!--
  TRMNL Liquid Template - Quadrant View
-->

{% if var_error %}
<div class="layout layout--stretch">
<div class="error-panel">
  <div class="error-card">
    <div class="header-bar">
      <div class="header-title">
        <span class="braun-indicator"></span>
        <span class="title title--small lg:title--large">ERROR</span>
      </div>
      <span class="header-category label label--small font--mono">API</span>
    </div>
    <div class="description lg:description--large" data-clamp="3" style="color: var(--framework-border-strong, #000000);">
      {{ var_error }}
    </div>
  </div>
</div>
</div>
{% else %}
<div class="layout layout--stretch">
<div class="main-stats flex flex--col w--full h--full gap--xsmall lg:gap--small">
  <!-- Header bar -->
  <div class="header-bar">
    <div class="header-title">
      <span class="braun-indicator"></span>
      <span class="title title--small lg:title--large" data-clamp="1">{{ var_game_name }}</span>
    </div>
    <span class="header-category label label--small lg:label--large font--mono">{{ var_category_name }}</span>
  </div>

  <!-- Hero World Record Card -->
  <div class="hero-wr">
    <div class="wr-meta">
      <span class="label label--small braun-kicker">WORLD RECORD</span>
      <span class="title title--small lg:title--large" data-clamp="1">{{ var_wr_holder }}</span>
      <span class="description lg:description--large wr-date">{{ var_wr_date }}</span>
    </div>
    <div class="value value--xsmall md:value--small lg:value--base value--tnums font--mono">
      {{ var_wr_time }}
    </div>
  </div>

  <!-- Compact Parameter Spec Box -->
  <div class="spec-box font--mono">
    <div class="spec-item">
      <span class="label label--small spec-label">RELEASED</span>
      <span class="description lg:description--large spec-val">{{ var_released_year }}</span>
    </div>
    <div class="spec-item">
      <span class="label label--small spec-label">RUNS</span>
      <span class="description lg:description--large spec-val">{{ var_total_runs }}</span>
    </div>
    <div class="spec-item">
      <span class="label label--small spec-label">2ND PLACE</span>
      <span class="description lg:description--large spec-val" data-clamp="1">{% if var_top_runs.size > 1 %}{{ var_top_runs[1].time }}{% else %}--{% endif %}</span>
    </div>
  </div>

  <!-- Bottom Dot Grille -->
  <div class="abstract-dots"></div>
</div>
</div>
{% endif %}
