<!--
  TRMNL Liquid Template (Braun / Bang & Olufsen Aesthetic)
  Copy-paste this template into your TRMNL Custom Markup Editor panel.
  This template matches the JSON variables output by your Transform JS script.
-->

{% if data.error %}
  {% assign var_error = data.error %}
{% else %}
  {% assign var_error = error %}
{% endif %}

{% if data.game_name %}
  {% assign var_game_name = data.game_name %}
  {% assign var_category_name = data.category_name %}
  {% assign var_cover_image = data.cover_image %}
  {% assign var_logo_image = data.logo_image %}
  {% assign var_icon_image = data.icon_image %}
  {% assign var_trophy_image = data.trophy_image %}
  {% assign var_wr_holder = data.wr_holder %}
  {% assign var_wr_date = data.wr_date %}
  {% assign var_wr_time = data.wr_time %}
  {% assign var_released_year = data.released_year %}
  {% assign var_system = data.system %}
  {% assign var_total_runs = data.total_runs %}
  {% assign var_top_runs = data.top_runs %}
  {% assign var_rules_summary = data.rules_summary %}
{% else %}
  {% assign var_game_name = game_name %}
  {% assign var_category_name = category_name %}
  {% assign var_cover_image = cover_image %}
  {% assign var_logo_image = logo_image %}
  {% assign var_icon_image = icon_image %}
  {% assign var_trophy_image = trophy_image %}
  {% assign var_wr_holder = wr_holder %}
  {% assign var_wr_date = wr_date %}
  {% assign var_wr_time = wr_time %}
  {% assign var_released_year = released_year %}
  {% assign var_system = system %}
  {% assign var_total_runs = total_runs %}
  {% assign var_top_runs = top_runs %}
  {% assign var_rules_summary = rules_summary %}
{% endif %}

<style>
  /* Left Column / Portrait Top Bar: Speaker Grille Pattern & Game Cover */
  .game-sidebar {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0;
  }

  /* Speaker Grille Pattern */
  .speaker-grille {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(var(--gray-30, #000000) 1.5px, transparent 1.8px);
    background-size: 8px 8px;
    z-index: 1;
  }

  .photo-frame {
    aspect-ratio: 95 / 134;
    width: auto;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 2;
    box-shadow: 5px 5px 0px var(--framework-border-strong, #000000);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px;
    text-align: center;
    background-color: var(--gray-60, #e5e5e5);
    color: var(--framework-border-strong, #000000);
  }

  .cover-fallback-tag {
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .error-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
  }

  .error-card {
    width: 100%;
    max-width: 620px;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    box-shadow: 6px 6px 0px var(--framework-border-strong, #000000);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Right Column: Main Stats */
  .main-stats {
    flex: 1;
    justify-content: flex-start;
  }

  .header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 3px solid var(--framework-border-strong, #000000);
    padding-bottom: 8px;
  }

  .header-title {
    font-weight: 800;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .braun-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--framework-border-strong, #000000);
    display: inline-block;
    flex-shrink: 0;
  }

  .header-category {
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hero-wr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    box-shadow: 5px 5px 0px var(--framework-border-strong, #000000);
  }

  .wr-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .braun-kicker {
    letter-spacing: 1.5px;
    font-weight: 800;
  }

  .wr-date {
    color: var(--gray-10, #1a1a1a);
    text-transform: uppercase;
  }

  /* Braun Parameter Spec Box */
  .spec-box {
    display: flex;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    text-align: center;
    box-shadow: 5px 5px 0px var(--framework-border-strong, #000000);
  }

  .spec-item {
    flex: 1;
    padding: 5px 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-item:not(:last-child) {
    border-right: 3px solid var(--framework-border-strong, #000000);
  }

  .spec-label {
    font-weight: 800;
    color: var(--gray-10, #1a1a1a);
    text-transform: uppercase;
  }

  .spec-val {
    font-weight: bold;
    text-transform: uppercase;
  }

  .braun-item {
    display: flex;
    align-items: center;
    border: 3px solid var(--framework-border-strong, #000000);
    min-height: 36px;
    background: var(--white, #ffffff);
    box-shadow: 4px 4px 0px var(--framework-border-strong, #000000);
  }

  .braun-index {
    width: 44px;
    align-self: stretch;
    border-right: 3px solid var(--framework-border-strong, #000000);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    background-color: var(--gray-50, #d4d4d4);
    flex-shrink: 0;
  }

  .braun-item-body {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 4px 14px;
  }

  .runner-name {
    font-weight: bold;
    text-transform: uppercase;
  }

  .run-date {
    color: var(--gray-10, #1a1a1a);
    margin-left: 8px;
  }

  .rules-container {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 3px double var(--framework-border-strong, #000000);
    padding-top: 8px;
  }

  .rules-body {
    color: var(--gray-10, #1a1a1a);
    font-style: italic;
    padding: 0 4px;
  }

  /* Abstract Braun dot grille filling remaining space dynamically */
  .abstract-dots {
    flex-grow: 1;
    width: 100%;
    background-image: radial-gradient(var(--gray-30, #000000) 1.5px, transparent 1.8px);
    background-size: 8px 8px;
    min-height: 10px;
  }
</style>

{% if var_error %}
<div class="layout layout--stretch">
<div class="error-panel">
  <div class="error-card">
    <div class="header-bar">
      <div class="header-title">
        <span class="braun-indicator"></span>
        <span class="title title--small lg:title--large">SPEEDRUN TRACKER // ERROR</span>
      </div>
      <span class="header-category label label--small lg:label--large font--mono">API / CONFIG</span>
    </div>
    <div class="description lg:description--large" style="color: var(--framework-border-strong, #000000);">
      {{ var_error }}
    </div>
  </div>
</div>
</div>
{% else %}
<div class="layout layout--stretch">
<div class="dashboard-layout flex flex--row portrait:flex--col w--full h--full gap--xlarge portrait:gap--large lg:portrait:gap--xxlarge">
  <!-- Left Column / Portrait Top Bar: Speaker Grille & Photo Stack -->
  <div class="game-sidebar flex flex--col portrait:flex--row w--[25cqw] portrait:w--full h--full portrait:h--[20cqh] lg:portrait:h--[18cqh] gap--medium lg:portrait:gap--xlarge">
    <div class="speaker-grille"></div>
    {% for slot in (1..3) %}
    <div class="photo-frame h--[25cqh] portrait:h--[15cqh]">
      {% if var_cover_image and var_cover_image != "" %}
      <img class="image-dither" src="{{ var_cover_image }}" alt="Cover Art {{ slot }}" onerror="this.style.display='none'; if(this.nextElementSibling){this.nextElementSibling.style.display='flex';}">
      <div class="cover-fallback font--mono" style="display: none;">
        <span class="value value--xxsmall lg:value--small value--tnums">0{{ slot }}</span>
        <span class="cover-fallback-tag label label--small">WR // SRC</span>
      </div>
      {% else %}
      <div class="cover-fallback font--mono">
        <span class="value value--xxsmall lg:value--small value--tnums">0{{ slot }}</span>
        <span class="cover-fallback-tag label label--small">WR // SRC</span>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  
  <!-- Right Column: Live Leaderboards and Record Status -->
  <div class="main-stats flex flex--col h--full portrait:w--full gap--small lg:gap--medium">
    <!-- Top Dot Grille -->
    <div class="abstract-dots"></div>

    <!-- Centered content block -->
    <div class="centered-content flex flex--col w--full gap--medium lg:gap--large">
      <!-- Header bar -->
      <div class="header-bar">
        <div class="header-title">
          <span class="braun-indicator"></span>
          <span class="title title--small lg:title--large">{{ var_game_name }}</span>
        </div>
        <span class="header-category label label--small lg:label--large font--mono">{{ var_category_name }}</span>
      </div>

      <!-- Hero World Record Stats Block -->
      <div class="hero-wr">
        <div class="wr-meta">
          <span class="label label--small lg:label--large braun-kicker">WORLD RECORD</span>
          <span class="title title--small lg:title--large">{{ var_wr_holder }}</span>
          <span class="description lg:description--large wr-date">{{ var_wr_date }}</span>
        </div>
        <div class="value value--small md:value--base lg:value--large value--tnums font--mono">
          {{ var_wr_time }}
        </div>
      </div>

      <!-- Braun Parameter Spec Box -->
      <div class="spec-box font--mono">
        <div class="spec-item">
          <span class="label label--small spec-label">RELEASED</span>
          <span class="description lg:description--large spec-val">{{ var_released_year }}</span>
        </div>
        {% if var_system and var_system != "N/A" and var_system != "" %}
        <div class="spec-item">
          <span class="label label--small spec-label">SYSTEM</span>
          <span class="description lg:description--large spec-val">{{ var_system }}</span>
        </div>
        {% endif %}
        <div class="spec-item">
          <span class="label label--small spec-label">TOTAL RUNS</span>
          <span class="description lg:description--large spec-val">{{ var_total_runs }}</span>
        </div>
        <div class="spec-item">
          <span class="label label--small spec-label">STATUS</span>
          <span class="description lg:description--large spec-val">ACTIVE</span>
        </div>
      </div>
      
      <!-- Top Leaderboard List -->
      <div class="leaderboard-list flex flex--col gap--xsmall lg:gap--small">
        <span class="label label--small lg:label--large braun-kicker">TOP RECORD LIST</span>
        
        {% if var_top_runs.size > 0 %}
        {% for run in var_top_runs %}
          <div class="braun-item">
            <div class="braun-index font--mono label label--small lg:label--large">0{{ run.place }}</div>
            <div class="braun-item-body">
              <div>
                <span class="title title--small lg:title--large runner-name">{{ run.runner }}</span>
                <span class="description lg:description--large run-date">{{ run.date }}</span>
              </div>
              <span class="title title--small lg:title--large font--mono">
                {{ run.time }}
              </span>
            </div>
          </div>
        {% endfor %}
        {% else %}
          <div class="braun-item">
            <div class="braun-index font--mono label label--small lg:label--large">--</div>
            <div class="braun-item-body">
              <span class="title title--small lg:title--large runner-name">NO VERIFIED RUNS</span>
              <span class="title title--small lg:title--large font--mono">N/A</span>
            </div>
          </div>
        {% endif %}
      </div>

      <!-- Category Rules Content Box at the Bottom -->
      <div class="rules-container">
        <span class="label label--small lg:label--large braun-kicker">CATEGORY RULES & DETAILS</span>
        <div class="rules-body description lg:description--large" data-clamp="3">
          "{{ var_rules_summary }}"
        </div>
      </div>
    </div>

    <!-- Bottom Dot Grille -->
    <div class="abstract-dots" style="margin-top: 10px;"></div>
  </div>
</div>
</div>
{% endif %}