<!--
  TRMNL Liquid Template (Braun / Bang & Olufsen Aesthetic)
  Copy-paste this template into your TRMNL Custom Markup Editor panel.
  This template matches the JSON variables output by your Transform JS script.
-->

{% if data.error %}
  {% assign var_error = data.error %}
{% else %}
  {% assign var_error = error %}
{% endif %}

{% if data.game_name %}
  {% assign var_game_name = data.game_name %}
  {% assign var_category_name = data.category_name %}
  {% assign var_cover_image = data.cover_image %}
  {% assign var_logo_image = data.logo_image %}
  {% assign var_icon_image = data.icon_image %}
  {% assign var_trophy_image = data.trophy_image %}
  {% assign var_wr_holder = data.wr_holder %}
  {% assign var_wr_date = data.wr_date %}
  {% assign var_wr_time = data.wr_time %}
  {% assign var_released_year = data.released_year %}
  {% assign var_system = data.system %}
  {% assign var_total_runs = data.total_runs %}
  {% assign var_top_runs = data.top_runs %}
  {% assign var_rules_summary = data.rules_summary %}
{% else %}
  {% assign var_game_name = game_name %}
  {% assign var_category_name = category_name %}
  {% assign var_cover_image = cover_image %}
  {% assign var_logo_image = logo_image %}
  {% assign var_icon_image = icon_image %}
  {% assign var_trophy_image = trophy_image %}
  {% assign var_wr_holder = wr_holder %}
  {% assign var_wr_date = wr_date %}
  {% assign var_wr_time = wr_time %}
  {% assign var_released_year = released_year %}
  {% assign var_system = system %}
  {% assign var_total_runs = total_runs %}
  {% assign var_top_runs = top_runs %}
  {% assign var_rules_summary = rules_summary %}
{% endif %}

<style>
  .dashboard-layout {
    display: flex;
    flex-direction: row;
    height: 100%;
    width: 100%;
    gap: 30px;
  }
  
  /* Left Column: Speaker Grille Pattern & Game Cover */
  .game-sidebar {
    width: 180px;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0;
    gap: 15px;
  }

  .centered-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }
  
  /* Speaker Grille Pattern */
  .speaker-grille {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(var(--gray-30, #000000) 1.5px, transparent 1.8px);
    background-size: 8px 8px;
    z-index: 1;
  }
  
  .photo-frame {
    width: 95px;
    height: 134px;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 2;
    box-shadow: 6px 6px 0px var(--framework-border-strong, #000000);
  }
  
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px;
    text-align: center;
    background-color: var(--gray-60, #e5e5e5);
    color: var(--framework-border-strong, #000000);
  }

  .cover-fallback-tag {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .cover-fallback-mark {
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
  }

  .error-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
  }

  .error-card {
    width: 100%;
    max-width: 620px;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    box-shadow: 6px 6px 0px var(--framework-border-strong, #000000);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .sidebar-label {
    z-index: 2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    background: var(--white, #ffffff);
    border: 2px solid var(--framework-border-strong, #000000);
    padding: 4px 14px;
    text-transform: uppercase;
    box-shadow: 3px 3px 0px var(--framework-border-strong, #000000);
  }
  


  /* Right Column: Spaced out using flex gaps, rule-box stretches to fill layout */
  .main-stats {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 100%;
    gap: 8px; /* Uniform spacing gap between elements */
  }
  
  .header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 3px solid var(--framework-border-strong, #000000);
    padding-bottom: 8px;
  }
  
  .header-title {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .braun-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--framework-border-strong, #000000);
    display: inline-block;
  }

  .header-category {
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  
  .hero-wr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    box-shadow: 5px 5px 0px var(--framework-border-strong, #000000);
  }
  
  .wr-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .wr-value {
    font-size: 34px;
    font-weight: 300;
    letter-spacing: -1px;
  }

  /* Braun Parameter Spec Box */
  .spec-box {
    display: flex;
    border: 3px solid var(--framework-border-strong, #000000);
    background-color: var(--white, #ffffff);
    text-align: center;
    font-size: 11px;
    box-shadow: 5px 5px 0px var(--framework-border-strong, #000000);
  }
  
  .spec-item {
    flex: 1;
    padding: 5px 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  
  .spec-item:not(:last-child) {
    border-right: 3px solid var(--framework-border-strong, #000000);
  }
  
  .spec-label {
    font-size: 8px;
    font-weight: 800;
    color: var(--gray-10, #1a1a1a);
    text-transform: uppercase;
  }
  
  .spec-val {
    font-weight: bold;
    text-transform: uppercase;
  }

  .leaderboard-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .braun-item {
    display: flex;
    align-items: center;
    border: 3px solid var(--framework-border-strong, #000000);
    height: 36px;
    background: var(--white, #ffffff);
    box-shadow: 4px 4px 0px var(--framework-border-strong, #000000);
  }
  
  .braun-index {
    width: 44px;
    height: 100%;
    border-right: 3px solid var(--framework-border-strong, #000000);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 13px;
    background-color: var(--gray-50, #d4d4d4);
  }
  
  .braun-item-body {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 14px;
  }
  
  .runner-name {
    font-size: 13px;
    font-weight: bold;
    text-transform: uppercase;
  }
  
  .run-date {
    font-size: 11px;
    color: var(--gray-10, #1a1a1a);
    margin-left: 8px;
  }
  
  .run-time {
    font-weight: bold;
  }

  .rules-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 3px double var(--framework-border-strong, #000000);
    padding-top: 8px;
  }

  .rules-body {
    font-size: 11px;
    line-height: 14px;
    color: var(--gray-10, #1a1a1a);
    font-style: italic;
    padding: 0 4px;
  }

  /* Abstract Braun dot grille filling remaining space dynamically */
  .abstract-dots {
    flex-grow: 1;
    width: 100%;
    background-image: radial-gradient(var(--gray-30, #000000) 1.5px, transparent 1.8px);
    background-size: 8px 8px;
    min-height: 10px;
  }

  /* Responsive styling for larger screens like TRMNL X */
  @media (min-width: 1024px) {
    .main-stats {
      gap: 14px;
    }
    .centered-content {
      gap: 20px;
    }
    .header-title {
      font-size: 28px;
    }
    .header-category {
      font-size: 16px;
    }
    .hero-wr {
      padding: 16px;
    }
    .wr-value {
      font-size: 46px;
    }
    .spec-box {
      font-size: 13px;
    }
    .spec-item {
      padding: 10px 4px;
    }
    .spec-label {
      font-size: 10px;
    }
    .spec-val {
      font-size: 13px;
    }
    .leaderboard-list {
      gap: 8px;
    }
    .braun-item {
      height: 48px;
    }
    .braun-index {
      font-size: 16px;
    }
    .runner-name {
      font-size: 16px;
    }
    .run-date {
      font-size: 13px;
    }
    .run-time {
      font-size: 16px;
    }
    .rules-body {
      font-size: 13px;
      line-height: 16px;
    }
  }

  /* Portrait orientation layout rules (Standard and TRMNL X) */
  @media (orientation: portrait) {
    .dashboard-layout {
      flex-direction: column;
      gap: 20px;
    }
    
    .game-sidebar {
      width: 100%;
      height: 140px;
      flex-direction: row;
      justify-content: center;
      gap: 15px;
    }
    
    .photo-frame {
      width: 75px;
      height: 106px;
      box-shadow: 4px 4px 0px var(--framework-border-strong, #000000);
    }
    
    .photo-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .main-stats {
      width: 100%;
    }
  }

  /* Scale up sizes specifically for TRMNL X in Portrait */
  @media (min-width: 1024px) and (orientation: portrait) {
    .game-sidebar {
      height: 260px;
      gap: 30px;
    }
    
    .photo-frame {
      width: 150px;
      height: 212px;
      border-width: 5px;
      box-shadow: 10px 10px 0px var(--framework-border-strong, #000000);
    }
    
    .dashboard-layout {
      gap: 40px;
    }
  }
</style>

{% if var_error %}
<div class="layout layout--stretch">
<div class="error-panel">
  <div class="error-card">
    <div class="header-bar">
      <div class="header-title">
        <span class="braun-indicator"></span>
        <span>SPEEDRUN TRACKER // ERROR</span>
      </div>
      <span class="header-category font--mono">API / CONFIG</span>
    </div>
    <div class="rules-body" style="font-style: normal; font-size: 14px; line-height: 20px; color: var(--framework-border-strong, #000000);">
      {{ var_error }}
    </div>
  </div>
</div>
</div>
{% else %}
<div class="layout layout--stretch">
<div class="dashboard-layout">
  <!-- Left Column: Speaker Grille & Photo Stack -->
  <div class="game-sidebar">
    <div class="speaker-grille"></div>
    {% for slot in (1..3) %}
    <div class="photo-frame">
      {% if var_cover_image and var_cover_image != "" %}
      <img class="image-dither" src="{{ var_cover_image }}" alt="Cover Art {{ slot }}" onerror="this.style.display='none'; if(this.nextElementSibling){this.nextElementSibling.style.display='flex';}">
      <div class="cover-fallback font--mono" style="display: none;">
        <span class="cover-fallback-mark">0{{ slot }}</span>
        <span class="cover-fallback-tag">WR // SRC</span>
      </div>
      {% else %}
      <div class="cover-fallback font--mono">
        <span class="cover-fallback-mark">0{{ slot }}</span>
        <span class="cover-fallback-tag">WR // SRC</span>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  
  <!-- Right Column: Live Leaderboards and Record Status -->
  <div class="main-stats">
    <!-- Top Dot Grille -->
    <div class="abstract-dots"></div>

    <!-- Centered content block -->
    <div class="centered-content">
      <!-- Header bar -->
      <div class="header-bar">
        <div class="header-title">
          <span class="braun-indicator"></span>
          <span>{{ var_game_name }}</span>
        </div>
        <span class="header-category font--mono">{{ var_category_name }}</span>
      </div>

      <!-- Hero World Record Stats Block -->
      <div class="hero-wr">
        <div class="wr-meta">
          <span class="label" style="letter-spacing: 1.5px; font-size: 10px; font-weight: 800;">WORLD RECORD</span>
          <span class="title title--small" style="font-size: 18px; margin-top: 3px;">{{ var_wr_holder }}</span>
          <span class="description" style="font-size: 11px; margin-top: 2px; color: var(--gray-10); text-transform: uppercase;">{{ var_wr_date }}</span>
        </div>
        <div class="wr-value font--mono">
          {{ var_wr_time }}
        </div>
      </div>

      <!-- Braun Parameter Spec Box -->
      <div class="spec-box font--mono">
        <div class="spec-item">
          <span class="spec-label">RELEASED</span>
          <span class="spec-val">{{ var_released_year }}</span>
        </div>
        {% if var_system and var_system != "N/A" and var_system != "" %}
        <div class="spec-item">
          <span class="spec-label">SYSTEM</span>
          <span class="spec-val">{{ var_system }}</span>
        </div>
        {% endif %}
        <div class="spec-item">
          <span class="spec-label">TOTAL RUNS</span>
          <span class="spec-val">{{ var_total_runs }}</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">STATUS</span>
          <span class="spec-val">ACTIVE</span>
        </div>
      </div>
      
      <!-- Top Leaderboard List -->
      <div class="leaderboard-list">
        <span class="label label--small" style="letter-spacing: 1.5px; font-size: 9px; font-weight: 800; margin-bottom: 2px;">TOP RECORD LIST</span>
        
        {% if var_top_runs.size > 0 %}
        {% for run in var_top_runs %}
          <div class="braun-item">
            <div class="braun-index font--mono">0{{ run.place }}</div>
            <div class="braun-item-body">
              <div>
                <span class="runner-name">{{ run.runner }}</span>
                <span class="run-date">{{ run.date }}</span>
              </div>
              <span class="run-time font--mono">
                {{ run.time }}
              </span>
            </div>
          </div>
        {% endfor %}
        {% else %}
          <div class="braun-item">
            <div class="braun-index font--mono">--</div>
            <div class="braun-item-body">
              <span class="runner-name">NO VERIFIED RUNS</span>
              <span class="run-time font--mono">N/A</span>
            </div>
          </div>
        {% endif %}
      </div>

      <!-- Category Rules Content Box at the Bottom -->
      <div class="rules-container">
        <span class="label label--small" style="letter-spacing: 1.5px; font-size: 9px; font-weight: 800;">CATEGORY RULES & DETAILS</span>
        <div class="rules-body">
          "{{ var_rules_summary }}"
        </div>
      </div>
    </div>

    <!-- Bottom Dot Grille -->
    <div class="abstract-dots" style="margin-top: 10px;"></div>
  </div>
</div>
</div>
{% endif %}
